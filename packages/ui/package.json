{
  "name": "@tableslayer/ui",
  "version": "0.2.9",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Siege-Perilous/tableslayer.git",
    "directory": "packages/ui"
  },
  "author": "Siege Perilous LLC",
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "ui",
    "tableslayer"
  ],
  "homepage": "https://github.com/Siege-Perilous/tableslayer/tree/main/packages/ui",
  "scripts": {
    "dev": "svelte-package --watch",
    "build": "svelte-kit sync && vite build && npm run package",
    "preview": "vite preview",
    "tsc": "svelte-kit sync && tsc",
    "package": "svelte-kit sync && svelte-package && typedoc",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "typedoc": "typedoc"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/*.css": {
      "import": "./dist/styles/*.css",
      "require": "./dist/styles/*.css"
    },
    "./typedoc.json": {
      "import": "./typedocgen.json",
      "require": "./typedocgen.json"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.16.0 || ^3.0.0",
    "svelte": "^5.19.0"
  },
  "devDependencies": {
    "@magidoc/plugin-svelte-marked": "^7.0.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tableslayer/eslint-config": "workspace:*",
    "@tableslayer/tsconfig": "workspace:*",
    "@types/chroma-js": "^3.1.3",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.6.5",
    "marked": "^18.1.1",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "typedoc": "^0.28.20",
    "typescript": "=6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tabler/icons-svelte": "^3.49.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "shiki": "^4.5.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
