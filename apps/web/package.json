{
  "name": "web",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev & wrangler dev --config partyserver/wrangler.jsonc --port 1999",
    "dev:vite": "vite dev",
    "dev:party": "wrangler dev --config partyserver/wrangler.jsonc --port 1999",
    "dev-local": "vite dev --host 0.0.0.0 --port 8080",
    "build": "svelte-kit sync && vite build",
    "deploy:party": "wrangler deploy --config partyserver/wrangler.jsonc",
    "preview": "vite preview",
    "start": "node build",
    "tsc": "svelte-kit sync && tsc",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:xvfb": "pnpm run test:unit && pnpm run test:integration:headed",
    "test:integration:headed": "playwright test --headed",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm run check:worker",
    "check:worker": "wrangler types --config partyserver/wrangler.jsonc --path partyserver/worker-configuration.d.ts --strict-vars false && tsc -p partyserver/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "generate": "drizzle-kit generate --config ./src/lib/db/app/drizzle.config.app.ts",
    "migrate": "drizzle-kit migrate --config ./src/lib/db/app/drizzle.config.app.ts",
    "push": "drizzle-kit push --config ./src/lib/db/app/drizzle.config.app.ts",
    "drop": "drizzle-kit drop --config ./src/lib/db/app/drizzle.config.app.ts",
    "pull": "drizzle-kit pull --config ./src/lib/db/app/drizzle.config.app.ts",
    "studio": "drizzle-kit studio --config ./src/lib/db/app/drizzle.config.app.ts",
    "assets:generate": "node scripts/assets-generate.js",
    "assets:upload": "node scripts/assets-upload.js",
    "postinstall": "svelte-kit sync"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "=3.712.0",
    "@aws-sdk/s3-request-presigner": "=3.712.0",
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@sentry/sveltekit": "^11.0.0",
    "@tabler/icons-svelte": "^3.48.0",
    "@tableslayer/stage": "workspace:*",
    "@tableslayer/ui": "workspace:*",
    "@tanstack/svelte-query": "^6.3.0",
    "@types/ws": "^8.18.1",
    "arctic": "^3.7.0",
    "chroma-js": "^3.2.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "lib0": "^0.2.118",
    "marked": "^18.0.14",
    "mime": "^4.1.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "partyserver": "^0.5.10",
    "slugify": "^1.6.9",
    "stripe": "^22.6.2",
    "uuid": "^14.0.2",
    "vite-sveltekit-node-ws": "^0.0.8",
    "ws": "^8.22.0",
    "y-partyserver": "^2.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tableslayer/eslint-config": "workspace:*",
    "@tableslayer/tsconfig": "workspace:*",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "postprocessing": "6.39.5",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "=6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.150.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
