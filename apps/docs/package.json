{
  "name": "docs",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev-local": "vite dev --host 0.0.0.0 --port 8080",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 8080",
    "tsc": "svelte-kit sync && tsc",
    "test": "pnpm run test:integration && pnpm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "postinstall": "svelte-kit sync"
  },
  "dependencies": {
    "@magidoc/plugin-svelte-marked": "^7.0.0",
    "@tabler/icons-svelte": "^3.49.0",
    "@tableslayer/stage": "workspace:*",
    "@tableslayer/ui": "workspace:*",
    "mode-watcher": "^1.1.0",
    "svelte-tweakpane-ui": "^1.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tableslayer/eslint-config": "workspace:*",
    "@tableslayer/tsconfig": "workspace:*",
    "@threlte/core": "8.6.1",
    "@threlte/extras": "9.22.3",
    "@tiptap/core": "^3.32.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "postprocessing": "6.39.5",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "=6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
